<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>game</AssemblyName>
    <RootNamespace>StardewOhos</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcDehydrate>false</IlcDehydrate>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MonoGame.Framework">
      <HintPath>../game-files/MonoGame.Framework.dll</HintPath>
    </Reference>
    <Reference Include="Stardew Valley"><HintPath>../game-files/Stardew Valley.dll</HintPath></Reference>
    <Reference Include="StardewValley.GameData"><HintPath>../game-files/StardewValley.GameData.dll</HintPath></Reference>
    <Reference Include="Lidgren.Network"><HintPath>../game-files/Lidgren.Network.dll</HintPath></Reference>
    <Reference Include="xTile"><HintPath>../game-files/xTile.dll</HintPath></Reference>
    <Reference Include="TextCopy"><HintPath>../game-files/TextCopy.dll</HintPath></Reference>
    <Reference Include="SkiaSharp"><HintPath>../game-files/SkiaSharp.dll</HintPath></Reference>
    <Reference Include="Steamworks.NET"><HintPath>../game-files/Steamworks.NET.dll</HintPath></Reference>
    <Reference Include="GalaxyCSharp"><HintPath>../game-files/GalaxyCSharp.dll</HintPath></Reference>
    <Reference Include="GalaxyCSharpGlue"><HintPath>../game-files/GalaxyCSharpGlue.dll</HintPath></Reference>
    <Reference Include="BmFont"><HintPath>../game-files/BmFont.dll</HintPath></Reference>
    <Reference Include="CPExtBmFont"><HintPath>../game-files/CPExtBmFont.dll</HintPath></Reference>
    <Reference Include="System.Data.HashFunction.Core"><HintPath>../game-files/System.Data.HashFunction.Core.dll</HintPath></Reference>
    <Reference Include="System.Data.HashFunction.Interfaces"><HintPath>../game-files/System.Data.HashFunction.Interfaces.dll</HintPath></Reference>
    <Reference Include="System.Data.HashFunction.xxHash"><HintPath>../game-files/System.Data.HashFunction.xxHash.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions"><HintPath>../game-files/Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <RdXmlFile Include="rd.xml" />
  </ItemGroup>
</Project>
